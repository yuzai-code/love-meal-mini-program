/* pages/menu/menu.wxss */
.page {
  min-height: 100vh;
  background: #fafafa;
  padding-bottom: 150rpx;
}

/* 分类导航 */
.category-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #fff;
  white-space: nowrap;
  z-index: 100;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.category-item {
  display: inline-block;
  padding: 15rpx 35rpx;
  margin: 0 15rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 30rpx;
}

.category-item.active {
  background: linear-gradient(135deg, #ff6b9d 0%, #ff8e8e 100%);
  color: #fff;
}

/* 常点推荐 */
.popular-section {
  margin-top: 100rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.popular-list {
  display: flex;
  gap: 20rpx;
}

.popular-item {
  background: #fff0f5;
  padding: 20rpx 30rpx;
  border-radius: 15rpx;
  white-space: nowrap;
}

/* 菜品列表 */
.dish-list {
  padding: 30rpx;
}

.dish-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 25rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.dish-image {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  padding: 25rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.popular-tag {
  font-size: 24rpx;
}

.dish-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.dish-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 15rpx;
}

.price {
  color: #ff6b9d;
  font-weight: bold;
  font-size: 34rpx;
}

.add-btn {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #ff6b9d 0%, #ff8e8e 100%);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 60rpx;
  font-size: 36rpx;
  font-weight: bold;
}

/* 购物车悬浮栏 */
.cart-bar {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  background: linear-gradient(135deg, #ff6b9d 0%, #ff8e8e 100%);
  border-radius: 60rpx;
  padding: 25rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 157, 0.4);
  z-index: 500;
}

.cart-info {
  position: relative;
}

.cart-icon {
  font-size: 50rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -15rpx;
  background: #fff;
  color: #ff6b9d;
  font-size: 22rpx;
  padding: 5rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

.cart-total {
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
}

.cart-bar .checkout-btn {
  background: #fff;
  color: #ff6b9d;
  padding: 15rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 购物车弹出层 */
.cart-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 600;
}

.cart-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.cart-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 70vh;
  padding: 30rpx;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.clear-btn {
  color: #ff6b9d;
  font-size: 28rpx;
}

.cart-items {
  max-height: 50vh;
  overflow-y: auto;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-item-name {
  flex: 1;
  font-size: 28rpx;
}

.cart-item-price {
  color: #ff6b9d;
  font-size: 28rpx;
  margin-right: 30rpx;
}

.cart-item-controls {
  display: flex;
  align-items: center;
  gap: 25rpx;
}

.cart-item-controls text {
  width: 50rpx;
  height: 50rpx;
  text-align: center;
  line-height: 50rpx;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 28rpx;
}

.cart-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 32rpx;
  font-weight: bold;
}

.cart-footer .checkout-btn {
  background: linear-gradient(135deg, #ff6b9d 0%, #ff8e8e 100%);
  color: #fff;
  padding: 20rpx 50rpx;
  border-radius: 40rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}
