/* pages/manage/manage.wxss */
.page { min-height: 100vh; background: #fafafa; padding: 30rpx; }
.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #333; }
.add-btn { background: linear-gradient(135deg, #ff6b9d 0%, #ff8e8e 100%); color: #fff; padding: 15rpx 35rpx; border-radius: 40rpx; font-size: 28rpx; }

.dish-list { display: flex; flex-direction: column; gap: 25rpx; }
.dish-card { background: #fff; border-radius: 20rpx; padding: 25rpx; display: flex; gap: 20rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05); }
.dish-img { width: 140rpx; height: 140rpx; border-radius: 15rpx; flex-shrink: 0; }
.dish-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.dish-top { display: flex; justify-content: space-between; align-items: flex-start; }
.dish-name { font-size: 30rpx; font-weight: bold; color: #333; margin-right: 15rpx; }
.dish-price { font-size: 28rpx; color: #ff6b9d; font-weight: bold; }
.popular-badge { font-size: 28rpx; }
.dish-category { font-size: 22rpx; color: #999; }
.dish-desc { font-size: 24rpx; color: #666; margin-top: 5rpx; }
.dish-actions { display: flex; flex-direction: column; gap: 15rpx; justify-content: center; }
.action-edit, .action-delete { font-size: 24rpx; padding: 10rpx 25rpx; border-radius: 20rpx; text-align: center; }
.action-edit { background: #f0f0f0; color: #666; }
.action-delete { background: #fff0f0; color: #ff6b9d; }

.empty { text-align: center; padding: 200rpx 0; color: #999; font-size: 28rpx; }

/* 表单弹窗 */
.form-popup { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999; }
.form-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); }
.form-content { position: absolute; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 30rpx 30rpx 0 0; max-height: 90vh; display: flex; flex-direction: column; }
.form-header { display: flex; justify-content: space-between; align-items: center; padding: 35rpx 40rpx; border-bottom: 1rpx solid #f0f0f0; font-size: 34rpx; font-weight: bold; flex-shrink: 0; }
.close-btn { font-size: 50rpx; color: #999; }
.form-body { padding: 30rpx 40rpx; flex: 1; overflow-y: auto; }
.form-item { margin-bottom: 35rpx; }
.label { font-size: 28rpx; color: #333; margin-bottom: 15rpx; display: block; font-weight: 500; }
.form-item input, .form-item textarea { background: #f5f5f5; border-radius: 15rpx; padding: 25rpx 30rpx; font-size: 28rpx; }
.form-item textarea { width: 100%; box-sizing: border-box; }
.picker-value { background: #f5f5f5; border-radius: 15rpx; padding: 25rpx 30rpx; font-size: 28rpx; }
.checkbox-item { flex-direction: row; align-items: center; }
.checkbox-item label { display: flex; align-items: center; gap: 10rpx; font-size: 28rpx; }
.form-footer { padding: 30rpx 40rpx; border-top: 1rpx solid #f0f0f0; }
.save-btn { background: linear-gradient(135deg, #ff6b9d 0%, #ff8e8e 100%); color: #fff; text-align: center; padding: 28rpx; border-radius: 50rpx; font-size: 32rpx; font-weight: bold; }
