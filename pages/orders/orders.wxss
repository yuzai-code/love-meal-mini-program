/* pages/orders/orders.wxss */
.page { min-height: 100vh; background: #fafafa; padding: 20rpx 30rpx; }
.filter-bar { display: flex; background: #fff; border-radius: 15rpx; padding: 10rpx; margin-bottom: 30rpx; }
.filter-item { flex: 1; text-align: center; padding: 20rpx 0; font-size: 26rpx; color: #666; border-radius: 10rpx; }
.filter-item.active { background: linear-gradient(135deg, #FF6347 0%, #E5533D 100%); color: #fff; font-weight: bold; }
.order-list { display: flex; flex-direction: column; gap: 25rpx; }
.order-card { background: #fff; border-radius: 20rpx; padding: 30rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05); }
.order-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25rpx; }
.order-id { font-size: 24rpx; color: #999; }
.status-tag { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 30rpx; }
.status-pending { background: #fff7e6; color: #ff9500; }
.status-accepted { background: #e8f4ff; color: #007aff; }
.status-completed { background: #e8f8f0; color: #34c759; }
.status-cancelled { background: #fff0f0; color: #ff3b30; }
.order-items { border-bottom: 1rpx solid #f0f0f0; padding-bottom: 20rpx; margin-bottom: 20rpx; }
.order-item { display: flex; gap: 20rpx; font-size: 28rpx; color: #333; margin-bottom: 12rpx; }
.item-price { margin-left: auto; color: #FF6347; }
.order-note, .order-address, .order-cancel-reason { font-size: 26rpx; color: #666; margin-bottom: 15rpx; padding: 15rpx; background: #f9f9f9; border-radius: 10rpx; }
.order-cancel-reason { background: #fff0f0; color: #ff3b30; }
.order-footer { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.order-time { font-size: 24rpx; color: #999; }
.order-total { font-size: 32rpx; font-weight: bold; color: #FF6347; }
.order-actions { display: flex; gap: 20rpx; justify-content: flex-end; }
.action-btn { padding: 15rpx 35rpx; border-radius: 40rpx; font-size: 26rpx; }
.action-btn.accept { background: #007aff; color: #fff; }
.action-btn.cancel { background: #ff3b30; color: #fff; }
.action-btn.complete { background: #34c759; color: #fff; }
.action-btn.detail { background: #f5f5f5; color: #666; }
.empty { text-align: center; padding: 200rpx 0; color: #999; }
