/* app.wxss - 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: #fafafa;
  font-size: 28rpx;
  color: #333;
}

/* 页面底部留白给自定义 Tab Bar */
.page {
  padding-bottom: 160rpx;
}

/* 通用容器 */
.container {
  padding: 30rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #FF6347 0%, #E5533D 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 99, 71, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #fff;
  color: #FF6347;
  border: 2rpx solid #FF6347;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
}

/* 输入框 */
.input {
  background: #f5f5f5;
  border-radius: 15rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

/* 价格文字 */
.price {
  color: #FF6347;
  font-weight: bold;
  font-size: 32rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  background: #fff0f0;
  color: #FF6347;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
